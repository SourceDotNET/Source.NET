<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;Debug (Dedicated);Release (Dedicated)</Configurations>
		<ApplicationIcon>SourceDotNET.ico</ApplicationIcon>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DefineConstants>$(DefineConstants);DBGFLAG_ASSERT</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug (Dedicated)|AnyCPU'">
	  <DefineConstants>$(DefineConstants);DBGFLAG_ASSERT</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\Usings\GlobalUsings.cs" Link="Usings/GlobalUsings.cs" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="SourceDotNET.ico" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Game.Client\Game.Client.csproj" />
		<ProjectReference Include="..\Game.Lua\Game.Lua.csproj" />
		<ProjectReference Include="..\Game.MenuSystem\Game.MenuSystem.csproj" />
		<ProjectReference Include="..\Game.Server\Game.Server.csproj" />
		<ProjectReference Include="..\Game.UI\Game.UI.csproj" />
		<ProjectReference Include="..\Game.Assets\Game.Assets.csproj" />
		<ProjectReference Include="..\Source.AudioSystem\Source.AudioSystem.csproj" />
		<ProjectReference Include="..\Source.DataCache\Source.DataCache.csproj" />
		<ProjectReference Include="..\Source.Engine\Source.Engine.csproj" />
		<ProjectReference Include="..\Source.Filesystem\Source.Filesystem.csproj" />
		<ProjectReference Include="..\Source.Physics\Source.Physics.csproj" />
		<ProjectReference Include="..\Source.SDLInputSystem\Source.SDLInputSystem.csproj" />
		<ProjectReference Include="..\Source.SDLManager\Source.SDLManager.csproj" />
		<ProjectReference Include="..\Source.MaterialSystem\Source.MaterialSystem.csproj" />
		<ProjectReference Include="..\Source.SDLSystem\Source.SDLSystem.csproj" />
		<ProjectReference Include="..\Source.ShaderAPI.Gl46\Source.ShaderAPI.Gl46.csproj" />
		<ProjectReference Include="..\Source.SoundEmitterSystem\Source.SoundEmitterSystem.csproj" />
		<ProjectReference Include="..\Source.StdShader.Gl46\Source.StdShader.Gl46.csproj" />
		<ProjectReference Include="..\Source.StudioRender\Source.StudioRender.csproj" />
		<ProjectReference Include="..\Source.VTF\Source.VTF.csproj" />
	</ItemGroup>

	<!-- Copy LuaJIT (Game.Lua imports "lua51", which .NET resolves to liblua51.so on Linux) -->
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\Dependencies\LuaJIT\win64\lua51.dll" Link="lua51.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="'$(IsWindows)'=='true'" />
		<None Include="$(MSBuildThisFileDirectory)..\Dependencies\LuaJIT\linux64\libluajit.so" Link="liblua51.so" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="'$(IsLinux)'=='true'" />
	</ItemGroup>
</Project>