<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Configurations>Debug;Release;Debug (Dedicated);Release (Dedicated)</Configurations>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\Usings\GlobalUsings.cs" Link="Usings/GlobalUsings.cs" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Source.Common\Source.Common.csproj" />
		<ProjectReference Include="..\Source.Bitmap\Source.Bitmap.csproj" />
		<ProjectReference Include="..\Source.GUI.Controls\Source.GUI.Controls.csproj" />
		<ProjectReference Include="..\Source.GUI\Source.GUI.csproj" />
		<ProjectReference Include="..\Game.Assets\Game.Assets.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="ppy.SDL3-CS" Version="2025.703.0" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
	</ItemGroup>
	<ItemGroup Condition="$(DefineConstants.Contains('GMOD_DLL'))">
		<PackageReference Include="FreeImage-dotnet-core" Version="4.3.6" ExcludeAssets="native" />
		<None Include="$(NuGetPackageRoot)freeimage-dotnet-core\4.3.6\runtimes\win7-x64\native\FreeImage.dll" Link="FreeImage.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(NuGetPackageRoot)freeimage-dotnet-core\4.3.6\runtimes\win7-x64\native\FreeImage.dll')" />
		<None Include="$(NuGetPackageRoot)freeimage-dotnet-core\4.3.6\runtimes\ubuntu.16.04-x64\native\FreeImage.so" Link="FreeImage.so" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('$(NuGetPackageRoot)freeimage-dotnet-core\4.3.6\runtimes\ubuntu.16.04-x64\native\FreeImage.so')" />
		<None Include="$(NuGetPackageRoot)freeimage-dotnet-core\4.3.6\runtimes\osx.10.10-x64\native\FreeImage.dylib" Link="FreeImage.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(NuGetPackageRoot)freeimage-dotnet-core\4.3.6\runtimes\osx.10.10-x64\native\FreeImage.dylib')" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="GarrysMod\" />
	</ItemGroup>

	<PropertyGroup>
		<BuildStampFile>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Configuration)\BuildStamp.txt</BuildStampFile>
	</PropertyGroup>
	<Target Name="UpdateBuildStamp" Inputs="@(Compile);$(MSBuildProjectFullPath);$(MSBuildThisFileDirectory)..\Directory.Build.props" Outputs="$(BuildStampFile)">
		<WriteLinesToFile File="$(BuildStampFile)" Lines="build$([System.DateTime]::UtcNow.ToString(&quot;yyyy-MM-ddTHH:mm:ss:fffZ&quot;))" Overwrite="true" />
	</Target>
	<Target Name="SetBuildStampRevision" DependsOnTargets="UpdateBuildStamp" BeforeTargets="AddSourceRevisionToInformationalVersion">
		<ReadLinesFromFile File="$(BuildStampFile)">
			<Output TaskParameter="Lines" PropertyName="SourceRevisionId" />
		</ReadLinesFromFile>
	</Target>
</Project>
