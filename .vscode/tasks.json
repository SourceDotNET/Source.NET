{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build Source.Launcher",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "--no-restore",
        "${workspaceFolder}/Source.Launcher/Source.Launcher.csproj",
        "-p:WarningLevel=0"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build Source.Dedicated",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "--no-restore",
        "${workspaceFolder}/Source.Dedicated/Source.Dedicated.csproj",
        "-p:WarningLevel=0",
        "-c",
        "Debug (Dedicated)"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}